@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ArticleList>

@{
    var articles = Model.Children<Article>();
}


<div class="article-card-list">
    @foreach (var article in articles)
    {
        <a href="@article.Url()" class="article-card">
            <h3>@article.Name</h3>
        </a>
    }
</div>
