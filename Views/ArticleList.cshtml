@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.ArticleList>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "master.cshtml";
}

<div class="article-list-page">


    @if (Model?.MainImage != null)
    {
        <div class="article-list-hero">
            <img src="@Model.MainImage.Url()" alt="@Model.MainImage.Name" />

            <div class="article-list-hero-content">
                @if (!string.IsNullOrWhiteSpace(Model?.Title))
                {
                    <h1>@Model.Title</h1>
                }

                @if (!string.IsNullOrWhiteSpace(Model?.Subtitle))
                {
                    <p>@Model.Subtitle</p>
                }
            </div>
        </div>
    }

    <div class="article-list-container">
        @await Html.PartialAsync("~/Views/Partials/_ArticleList.cshtml")
    </div>

</div>
