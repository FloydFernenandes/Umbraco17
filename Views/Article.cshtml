@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Article>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco17.Services;
@inject IReadingTimeService ReadingTimeService
@{
	Layout = "master.cshtml";

    var readingMinutes = ReadingTimeService.CalculateReadingTime(Model?.Body?.ToString() ?? string.Empty);

}

<div class="article">

    @if (Model?.HeroImage != null)
    {
        <div class="article-hero">
            <img src="@Model.HeroImage.Url()" alt="@Model?.Title ?? " Article image"" />

            <div class="article-hero-content">
                @if (!string.IsNullOrWhiteSpace(Model?.Title))
                {
                    <h1>@Model.Title</h1>
                }

                @if (!string.IsNullOrWhiteSpace(Model?.Intro))
                {
                    <p class="intro">@Model.Intro</p>
                }
            </div>
        </div>
    }

    @if (Model?.PublishedDate != null)
    {
        <div class="article-meta">
        <p class="article-date">Published Date: @Model.PublishedDate.ToString("MMMM dd, yyyy")</p>
        <span class="article-sep">•</span>
        <span class="article-readtime">~@readingMinutes min read</span>
        </div>
    }

    <div class="article-body">
        @if (!string.IsNullOrEmpty(Model.Body.ToString()))
        {
        @Html.Raw(Model.Body)
        }
    </div>

</div>
