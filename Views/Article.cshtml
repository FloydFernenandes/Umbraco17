@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Article>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "master.cshtml";
}



@if (Model.HeroImage != null)
{
    <img src="@Model.HeroImage.Url()" alt="" />
}

<p>@Model.PublishedDate</p>

@if (!string.IsNullOrWhiteSpace(Model.Title))
    {
        <h1 class="article-title">@Model.Title</h1>
    }


    @if (!string.IsNullOrWhiteSpace(Model.Intro))
    {
        <p class="article-intro">@Model.Intro</p>
    }

@Html.Raw(Model.Body)

